@page "/"
@using Casos.Core
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>@Textos.De("Marca")</PageTitle>

@{
    var lectura = LecturaHoja.Leer(filas, nombreHistoria, reglas, porPares);
    var casos = lectura.TieneAvisos ? [] : GeneradorCasos.Generar(lectura.Historia);
}

<section class="seccion" aria-labelledby="campos-titulo">
    <h1 class="titulo" id="campos-titulo">@Textos.De("Pagina.CamposDeLaHistoria")</h1>
    <div class="barra-historia">
        <div class="ejemplos" role="group" aria-labelledby="ejemplos-titulo">
            <span class="ejemplos__etiqueta" id="ejemplos-titulo">@Textos.De("Ejemplos.Titulo")</span>
            @foreach (var ejemplo in EjemplosHistoria.Todos())
            {
                <button type="button" class="boton boton--pequeno" @onclick="() => Cargar(ejemplo)">@ejemplo.Historia</button>
            }
        </div>
        <button type="button" class="quitar" disabled="@(!HayDatos)" @onclick="EmpezarDeNuevo">@Textos.De("Historia.EmpezarDeNuevo")</button>
    </div>
    <ProponerCampos Aceptar="AceptarPropuesta" />
    <p class="nombre-historia">
        <label for="nombre-historia">@Textos.De("Pagina.NombreDeLaHistoria")</label>
        <input id="nombre-historia" @bind="nombreHistoria" @bind:after="MarcarCambio" placeholder="@Textos.De("Pagina.EjemploHistoria")" />
    </p>
    <HojaCampos Filas="filas" Avisos="lectura.Avisos" CambioFilas="MarcarCambio" />
</section>

<section class="seccion" aria-labelledby="reglas-titulo">
    <h2 class="titulo" id="reglas-titulo">@Textos.De("Reglas.Titulo")</h2>
    <HojaReglas Reglas="reglas" Filas="filas" Avisos="lectura.AvisosReglas" CambioReglas="MarcarCambio" />
</section>

<section class="seccion" aria-labelledby="pares-titulo">
    <h2 class="titulo" id="pares-titulo">@Textos.De("Pares.Titulo")</h2>
    <p class="casilla">
        <input type="checkbox" id="por-pares" @bind="porPares" @bind:after="MarcarCambio"
               aria-describedby="@(lectura.AvisoPares is null ? null : "aviso-pares")" />
        <label for="por-pares">@Textos.De("Pares.Combinar")</label>
    </p>
    @if (lectura.AvisoPares is { } avisoPares)
    {
        <p class="aviso" id="aviso-pares">@avisoPares</p>
    }
    else if (lectura.Historia.PorPares && !lectura.TieneAvisos)
    {
        <p class="estado">@TextosCaso.TotalPares(lectura.Historia, casos)</p>
    }
    <p class="ayuda">@Textos.De("Pares.Ayuda")</p>
</section>

<section class="seccion" aria-labelledby="casos-titulo">
    <h2 class="titulo" id="casos-titulo">@Textos.De("Pagina.CasosGenerados")</h2>
    @if (lectura.TieneAvisos)
    {
        <p class="estado">@Textos.De("Pagina.CorrigeAvisos")</p>
    }
    else if (casos.Count == 0)
    {
        <p class="estado">@Textos.De("Pagina.AgregaCampo")</p>
    }
    else
    {
        <CasosGenerados Historia="lectura.Historia" Casos="casos" @bind-Vista="vista" />
    }
</section>

@code {
    private const string ClaveGuardado = "historia";

    private readonly List<FilaCampo> filas = [new()];
    private readonly List<FilaRegla> reglas = [];
    private string nombreHistoria = "";
    private bool porPares;
    private VistaCasos vista;

    // Si se escribió algo a mano desde que se empezó la historia o se cargó el último ejemplo. Se guarda con ella.
    private bool hayCambiosPropios;

    // El módulo que guarda en el navegador. Queda en null hasta restaurar lo guardado, para no pisarlo con la hoja vacía.
    private IJSObjectReference? almacen;
    private string? ultimoGuardado;

    private bool HayDatos =>
        !string.IsNullOrWhiteSpace(nombreHistoria) || filas.Any(fila => !fila.EstaVacia) || reglas.Any(regla => !regla.EstaVacia);

    protected override async Task OnInitializedAsync()
    {
        var modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/almacen.js");
        if (HistoriaGuardada.DesdeJson(await modulo.InvokeAsync<string?>("leer", ClaveGuardado)) is { } guardada)
        {
            nombreHistoria = guardada.Nombre;
            Reemplazar(guardada.Filas, guardada.PorPares);
            reglas.AddRange(guardada.Reglas);
            hayCambiosPropios = guardada.CambiosPropios;
        }

        almacen = modulo;
    }

    // Cada cambio vuelve a dibujar la página, así que después de dibujarla se guarda lo que haya cambiado.
    // Una hoja vacía borra lo guardado.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (almacen is null)
        {
            return;
        }

        var json = HayDatos ? new HistoriaGuardada(nombreHistoria, filas, reglas, porPares, hayCambiosPropios).AJson() : null;
        if (json == ultimoGuardado)
        {
            return;
        }

        ultimoGuardado = json;
        await (json is null
            ? almacen.InvokeVoidAsync("borrar", ClaveGuardado)
            : almacen.InvokeVoidAsync("guardar", ClaveGuardado, json));
    }

    private void MarcarCambio() => hayCambiosPropios = true;

    private async Task EmpezarDeNuevo()
    {
        if (!await PuedeReemplazar("Historia.ConfirmarEmpezar"))
        {
            return;
        }

        nombreHistoria = "";
        Reemplazar([new FilaCampo()], combinarPorPares: false);
        hayCambiosPropios = false;
    }

    private async Task Cargar(EjemplosHistoria.Ejemplo ejemplo)
    {
        if (!await PuedeReemplazar("Ejemplos.Confirmar"))
        {
            return;
        }

        nombreHistoria = ejemplo.Historia;
        Reemplazar(ejemplo.Filas, ejemplo.PorPares);
        hayCambiosPropios = false;
    }

    // Los campos propuestos pasan a ser del usuario: cargar después un ejemplo vuelve a preguntar.
    private async Task<bool> AceptarPropuesta(IReadOnlyList<FilaCampo> propuesta)
    {
        if (!await PuedeReemplazar("Propuesta.Confirmar"))
        {
            return false;
        }

        Reemplazar(propuesta, combinarPorPares: false);
        hayCambiosPropios = true;
        StateHasChanged();
        return true;
    }

    // Solo se pregunta si hay algo escrito a mano: quien va probando un ejemplo tras otro no ve la pregunta cada vez.
    private async Task<bool> PuedeReemplazar(string claveConfirmacion) =>
        !hayCambiosPropios || !HayDatos || await JS.InvokeAsync<bool>("confirm", Textos.De(claveConfirmacion));

    private void Reemplazar(IEnumerable<FilaCampo> nuevas, bool combinarPorPares)
    {
        filas.Clear();
        filas.AddRange(nuevas);
        reglas.Clear();
        porPares = combinarPorPares;
    }

    public async ValueTask DisposeAsync()
    {
        if (almacen is not null)
        {
            await almacen.DisposeAsync();
        }
    }
}
