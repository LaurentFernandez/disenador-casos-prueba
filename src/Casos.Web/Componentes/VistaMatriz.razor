@using Casos.Core.Modelo

<p class="ayuda ayuda--arriba">@Textos.De("Matriz.Ayuda")</p>

<div class="panel desplazable">
    <table class="matriz">
        <caption class="visualmente-oculto">@Textos.De("Matriz.Titulo")</caption>
        <thead>
            <tr>
                <th scope="col">@Textos.De("Columna.Codigo")</th>
                <th scope="col">@Textos.De("Columna.Descripcion")</th>
                <th scope="col">@Textos.De("Columna.Tecnica")</th>
                @foreach (var campo in Campos)
                {
                    <th scope="col">@campo.Nombre</th>
                }
                <th scope="col">@Textos.De("Columna.Resultado")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var caso in Casos)
            {
                <tr>
                    <th scope="row">@caso.Codigo</th>
                    <td>@TextosCaso.Descripcion(caso)</td>
                    <td>
                        <span class="tecnica">
                            <span class="icono icono--@ClaseIcono(caso.Tecnica)" aria-hidden="true"></span>
                            @TextosCaso.NombreTecnica(caso.Tecnica)
                        </span>
                    </td>
                    @foreach (var campo in Campos)
                    {
                        var valor = caso.Datos[campo.Nombre];
                        // El caso con todos los valores por defecto prueba todos los campos a la vez; el de una regla, sus dos campos.
                        var probado = caso.CampoProbado is null || caso.CampoProbado == campo || caso.Regla?.CampoCondicion == campo.Nombre;
                        <td class="@ClaseDeValor(probado, caso.EsValido)">
                            <span class="@(valor.Length == 0 ? "vacio" : null)">@TextosCaso.Valor(valor)</span>
                            @if (probado)
                            {
                                <span class="visualmente-oculto">, @Textos.De("Matriz.ValorProbado")</span>
                            }
                        </td>
                    }
                    <td>
                        <span class="resultado resultado--@(caso.EsValido ? "acepta" : "rechaza")">
                            <span aria-hidden="true">@(caso.EsValido ? "✓" : "✕")</span>
                            @TextosCaso.Resultado(caso)
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Campo> Campos { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<CasoPrueba> Casos { get; set; } = [];

    private static string ClaseIcono(Tecnica tecnica) => tecnica switch
    {
        Tecnica.ParticionEquivalencia => "particion",
        Tecnica.ValoresLimite => "limite",
        _ => "decision",
    };

    private static string ClaseDeValor(bool probado, bool valido) =>
        !probado ? "valor" : valido ? "valor valor--valido" : "valor valor--invalido";
}
