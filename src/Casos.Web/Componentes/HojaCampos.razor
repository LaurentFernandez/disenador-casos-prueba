<div class="panel desplazable">
    <table class="hoja">
        <caption class="visualmente-oculto">Campos de la historia</caption>
        <colgroup>
            <col class="columna-campo" />
            <col class="columna-tipo" />
            <col class="columna-obligatorio" />
            <col class="columna-numero" />
            <col class="columna-numero" />
            <col />
            <col class="columna-quitar" />
        </colgroup>
        <thead>
            <tr>
                <th scope="col">Campo</th>
                <th scope="col">Tipo</th>
                <th scope="col">Obligatorio</th>
                <th scope="col">Mínimo</th>
                <th scope="col">Máximo</th>
                <th scope="col">Opciones</th>
                <th scope="col"><span class="visualmente-oculto">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
            @for (var indice = 0; indice < Filas.Count; indice++)
            {
                var fila = Filas[indice];
                var numero = indice + 1;
                var aviso = Avisos.GetValueOrDefault(fila);
                var idAviso = aviso is null ? null : $"aviso-campo-{numero}";

                <tr @key="fila">
                    <td>
                        <input class="celda" @bind="fila.Nombre" @bind:after="AvisarCambio" aria-label="Nombre del campo @numero"
                               aria-invalid="@(aviso is null ? null : "true")" aria-describedby="@idAviso" />
                    </td>
                    <td>
                        <select class="celda" @bind="fila.Tipo" @bind:after="AvisarCambio" aria-label="Tipo del campo @numero">
                            <option value="@TipoCampo.Entero">Entero</option>
                            <option value="@TipoCampo.Texto">Texto</option>
                            <option value="@TipoCampo.Lista">Lista</option>
                        </select>
                    </td>
                    <td class="centrado">
                        <input type="checkbox" @bind="fila.Obligatorio" @bind:after="AvisarCambio" aria-label="Campo @numero obligatorio" />
                    </td>
                    @if (fila.Tipo == TipoCampo.Lista)
                    {
                        <td class="no-aplica"><span class="visualmente-oculto">No aplica</span></td>
                        <td class="no-aplica"><span class="visualmente-oculto">No aplica</span></td>
                        <td>
                            <input class="celda" @bind="fila.Opciones" @bind:after="AvisarCambio" placeholder="Ejemplo: Persona, Empresa"
                                   aria-label="Opciones del campo @numero, separadas por comas" />
                        </td>
                    }
                    else
                    {
                        <td><input type="number" class="celda celda--numero" @bind="fila.Minimo" @bind:after="AvisarCambio" aria-label="Mínimo del campo @numero" /></td>
                        <td><input type="number" class="celda celda--numero" @bind="fila.Maximo" @bind:after="AvisarCambio" aria-label="Máximo del campo @numero" /></td>
                        <td class="no-aplica"><span class="visualmente-oculto">No aplica</span></td>
                    }
                    <td class="centrado">
                        <button type="button" class="quitar" aria-label="Quitar el campo @numero" @onclick="() => Quitar(fila)">Quitar</button>
                    </td>
                </tr>

                @if (aviso is not null)
                {
                    <tr class="fila-aviso">
                        <td colspan="7" id="@idAviso">@aviso</td>
                    </tr>
                }
            }

            @if (Filas.Count == 0)
            {
                <tr>
                    <td colspan="7" class="sin-campos">No hay campos. Agrega el primero con «Agregar campo».</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="ayuda">En los campos de texto, mínimo y máximo son la longitud en caracteres. Separa las opciones de una lista con comas.</p>

<button type="button" class="boton agregar" @onclick="Agregar">Agregar campo</button>

@code {
    [Parameter, EditorRequired]
    public List<FilaCampo> Filas { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyDictionary<FilaCampo, string> Avisos { get; set; } = new Dictionary<FilaCampo, string>();

    /// <summary>
    /// Avisa a la página que la hoja cambió, para que la vuelva a leer.
    /// </summary>
    [Parameter]
    public EventCallback CambioFilas { get; set; }

    private Task AvisarCambio() => CambioFilas.InvokeAsync();

    private Task Agregar()
    {
        Filas.Add(new FilaCampo());
        return AvisarCambio();
    }

    private Task Quitar(FilaCampo fila)
    {
        Filas.Remove(fila);
        return AvisarCambio();
    }
}
