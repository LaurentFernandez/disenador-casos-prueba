<div class="panel desplazable">
    <table class="hoja">
        <caption class="visualmente-oculto">@Textos.De("Pagina.CamposDeLaHistoria")</caption>
        <colgroup>
            <col class="columna-campo" />
            <col class="columna-tipo" />
            <col class="columna-obligatorio" />
            <col class="columna-numero" />
            <col class="columna-numero" />
            <col />
            <col class="columna-quitar" />
        </colgroup>
        <thead>
            <tr>
                <th scope="col">@Textos.De("Hoja.Campo")</th>
                <th scope="col">@Textos.De("Hoja.Tipo")</th>
                <th scope="col">@Textos.De("Hoja.Obligatorio")</th>
                <th scope="col">@Textos.De("Hoja.Minimo")</th>
                <th scope="col">@Textos.De("Hoja.Maximo")</th>
                <th scope="col">@Textos.De("Hoja.Opciones")</th>
                <th scope="col"><span class="visualmente-oculto">@Textos.De("Hoja.Acciones")</span></th>
            </tr>
        </thead>
        <tbody>
            @for (var indice = 0; indice < Filas.Count; indice++)
            {
                var fila = Filas[indice];
                var numero = indice + 1;
                var aviso = Avisos.GetValueOrDefault(fila);
                var idAviso = aviso is null ? null : $"aviso-campo-{numero}";

                <tr @key="fila">
                    <td>
                        <input class="celda" @bind="fila.Nombre" @bind:after="AvisarCambio" aria-label="@Textos.De("Hoja.NombreDelCampo", numero)"
                               aria-invalid="@(aviso is null ? null : "true")" aria-describedby="@idAviso" />
                    </td>
                    <td>
                        <select class="celda" @bind="fila.Tipo" @bind:after="AvisarCambio" aria-label="@Textos.De("Hoja.TipoDelCampo", numero)">
                            @foreach (var tipo in Enum.GetValues<TipoCampo>())
                            {
                                <option value="@tipo">@Textos.De($"Tipo.{tipo}")</option>
                            }
                        </select>
                    </td>
                    <td class="centrado">
                        <input type="checkbox" @bind="fila.Obligatorio" @bind:after="AvisarCambio" aria-label="@Textos.De("Hoja.CampoObligatorio", numero)" />
                    </td>
                    @if (fila.Tipo == TipoCampo.Lista)
                    {
                        <td class="no-aplica"><span class="visualmente-oculto">@Textos.De("Hoja.NoAplica")</span></td>
                        <td class="no-aplica"><span class="visualmente-oculto">@Textos.De("Hoja.NoAplica")</span></td>
                        <td>
                            <input class="celda" @bind="fila.Opciones" @bind:after="AvisarCambio" placeholder="@Textos.De("Hoja.EjemploOpciones")"
                                   aria-label="@Textos.De("Hoja.OpcionesDelCampo", numero)" />
                        </td>
                    }
                    else
                    {
                        <td><input type="number" class="celda celda--numero" @bind="fila.Minimo" @bind:after="AvisarCambio" aria-label="@Textos.De("Hoja.MinimoDelCampo", numero)" /></td>
                        <td><input type="number" class="celda celda--numero" @bind="fila.Maximo" @bind:after="AvisarCambio" aria-label="@Textos.De("Hoja.MaximoDelCampo", numero)" /></td>
                        <td class="no-aplica"><span class="visualmente-oculto">@Textos.De("Hoja.NoAplica")</span></td>
                    }
                    <td class="centrado">
                        <button type="button" class="quitar" aria-label="@Textos.De("Hoja.QuitarElCampo", numero)" @onclick="() => Quitar(fila)">@Textos.De("Hoja.Quitar")</button>
                    </td>
                </tr>

                @if (aviso is not null)
                {
                    <tr class="fila-aviso">
                        <td colspan="7" id="@idAviso">@aviso</td>
                    </tr>
                }
            }

            @if (Filas.Count == 0)
            {
                <tr>
                    <td colspan="7" class="sin-campos">@Textos.De("Hoja.SinCampos")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="ayuda">@Textos.De("Hoja.Ayuda")</p>

<button type="button" class="boton agregar" @onclick="Agregar">@Textos.De("Hoja.AgregarCampo")</button>

@code {
    [Parameter, EditorRequired]
    public List<FilaCampo> Filas { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyDictionary<FilaCampo, string> Avisos { get; set; } = new Dictionary<FilaCampo, string>();

    /// <summary>
    /// Avisa a la página que la hoja cambió, para que la vuelva a leer.
    /// </summary>
    [Parameter]
    public EventCallback CambioFilas { get; set; }

    private Task AvisarCambio() => CambioFilas.InvokeAsync();

    private Task Agregar()
    {
        Filas.Add(new FilaCampo());
        return AvisarCambio();
    }

    private Task Quitar(FilaCampo fila)
    {
        Filas.Remove(fila);
        return AvisarCambio();
    }
}
