@using Casos.Core.Modelo

@{
    var validos = Casos.Count(caso => caso.EsValido);
}

<p class="resumen">@Casos.Count casos: @validos se aceptan y @(Casos.Count - validos) se rechazan.</p>

<div class="barra-vistas">
    <div class="segmentos" role="tablist" aria-label="Vista de los casos">
        <button type="button" role="tab" id="pestana-matriz" aria-controls="panel-casos"
                aria-selected="@(Vista == VistaCasos.Matriz ? "true" : "false")" @onclick="() => Elegir(VistaCasos.Matriz)">Matriz</button>
        <button type="button" role="tab" id="pestana-recta" aria-controls="panel-casos"
                aria-selected="@(Vista == VistaCasos.Recta ? "true" : "false")" @onclick="() => Elegir(VistaCasos.Recta)">Recta</button>
    </div>

    <ul class="leyenda" aria-label="Leyenda">
        <li><span class="muestra muestra--valida" aria-hidden="true"></span>Válido</li>
        <li><span class="muestra muestra--invalida" aria-hidden="true"></span>Inválido</li>
        <li><span class="icono icono--particion" aria-hidden="true"></span>Partición de equivalencia</li>
        <li><span class="icono icono--limite" aria-hidden="true"></span>Valor límite</li>
    </ul>
</div>

<div id="panel-casos" role="tabpanel" aria-labelledby="@(Vista == VistaCasos.Matriz ? "pestana-matriz" : "pestana-recta")">
    @if (Vista == VistaCasos.Matriz)
    {
        <VistaMatriz Campos="Campos" Casos="Casos" />
    }
    else
    {
        <VistaRecta Campos="Campos" Casos="Casos" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Campo> Campos { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<CasoPrueba> Casos { get; set; } = [];

    /// <summary>
    /// La vista elegida. La guarda la página para no perderla cuando un aviso oculta los casos.
    /// </summary>
    [Parameter]
    public VistaCasos Vista { get; set; }

    [Parameter]
    public EventCallback<VistaCasos> VistaChanged { get; set; }

    private Task Elegir(VistaCasos vista) => VistaChanged.InvokeAsync(vista);
}
