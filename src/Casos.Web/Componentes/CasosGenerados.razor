@using Casos.Core.Modelo

@{
    var validos = Casos.Count(caso => caso.EsValido);
}

<p class="resumen">@Casos.Count casos: @validos se aceptan y @(Casos.Count - validos) se rechazan.</p>

<ul class="leyenda" aria-label="Leyenda">
    <li><span class="muestra muestra--valida" aria-hidden="true"></span>Válido</li>
    <li><span class="muestra muestra--invalida" aria-hidden="true"></span>Inválido</li>
    <li><span class="icono icono--particion" aria-hidden="true"></span>Partición de equivalencia</li>
    <li><span class="icono icono--limite" aria-hidden="true"></span>Valor límite</li>
</ul>

<VistaMatriz Campos="Campos" Casos="Casos" />

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Campo> Campos { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<CasoPrueba> Casos { get; set; } = [];
}
