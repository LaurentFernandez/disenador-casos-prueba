@using Casos.Core.Modelo
@implements IAsyncDisposable
@inject IJSRuntime JS

<p class="resumen">@TextosCaso.Resumen(Casos)</p>

<div class="barra-vistas">
    <div class="segmentos" role="tablist" aria-label="Vista de los casos">
        @foreach (var opcion in Enum.GetValues<VistaCasos>())
        {
            <button type="button" role="tab" id="@IdPestana(opcion)" aria-controls="panel-casos"
                    aria-selected="@(Vista == opcion ? "true" : "false")" @onclick="() => Elegir(opcion)">@opcion</button>
        }
    </div>

    @if (Vista != VistaCasos.Gherkin)
    {
        <ul class="leyenda" aria-label="Leyenda">
            <li><span class="muestra muestra--valida" aria-hidden="true"></span>Válido</li>
            <li><span class="muestra muestra--invalida" aria-hidden="true"></span>Inválido</li>
            <li><span class="icono icono--particion" aria-hidden="true"></span>Partición de equivalencia</li>
            <li><span class="icono icono--limite" aria-hidden="true"></span>Valor límite</li>
        </ul>
    }

    <div class="exportar" role="group" aria-label="Exportar los casos">
        <span class="exportar__etiqueta" aria-hidden="true">Exportar</span>
        <button type="button" class="boton boton--pequeno" aria-label="Descargar en CSV"
                @onclick="() => Descargar(ExportacionCasos.Csv(Historia, Casos))">CSV</button>
        <button type="button" class="boton boton--pequeno" aria-label="Descargar en Markdown"
                @onclick="() => Descargar(ExportacionCasos.Markdown(Historia, Casos))">Markdown</button>
        <button type="button" class="boton boton--pequeno" aria-label="Descargar en .feature"
                @onclick="() => Descargar(ExportacionCasos.Feature(Historia, Casos))">.feature</button>
    </div>
</div>

<div id="panel-casos" role="tabpanel" aria-labelledby="@IdPestana(Vista)">
    @switch (Vista)
    {
        case VistaCasos.Matriz:
            <VistaMatriz Campos="Historia.Campos" Casos="Casos" />
            break;
        case VistaCasos.Recta:
            <VistaRecta Campos="Historia.Campos" Casos="Casos" />
            break;
        default:
            <p class="ayuda ayuda--arriba">Un texto se describe por su longitud, por ejemplo «un texto de 26 caracteres», para que el escenario se pueda leer.</p>
            <pre class="codigo"><code>@GherkinCasos.Caracteristica(Historia, Casos)</code></pre>
            break;
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Historia Historia { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyList<CasoPrueba> Casos { get; set; } = [];

    /// <summary>
    /// La vista elegida. La guarda la página para no perderla cuando un aviso oculta los casos.
    /// </summary>
    [Parameter]
    public VistaCasos Vista { get; set; }

    [Parameter]
    public EventCallback<VistaCasos> VistaChanged { get; set; }

    private static string IdPestana(VistaCasos vista) => $"pestana-{vista.ToString().ToLowerInvariant()}";

    private IJSObjectReference? descargas;

    private Task Elegir(VistaCasos vista) => VistaChanged.InvokeAsync(vista);

    private async Task Descargar(ExportacionCasos.Archivo archivo)
    {
        descargas ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/descargas.js");
        await descargas.InvokeVoidAsync("descargar", archivo.Nombre, archivo.Tipo, archivo.Contenido);
    }

    public async ValueTask DisposeAsync()
    {
        if (descargas is not null)
        {
            await descargas.DisposeAsync();
        }
    }
}
